#!/usr/bin/env bash
# This repo is public, and a push cannot be taken back. Block commits that carry
# private names (patterns live in the private agent-context repo, so the list
# itself never lands here) or secrets that gitleaks recognizes.
set -uo pipefail

denylist="${DOTFILES_DENYLIST:-$HOME/.config/agents/public-denylist.txt}"
zero=0000000000000000000000000000000000000000

if [ -r "$denylist" ]; then
  pattern=$(grep -vE '^[[:space:]]*(#|$)' "$denylist" | paste -sd'|' -)
elif [ "${DOTFILES_ALLOW_NO_DENYLIST:-}" = 1 ]; then
  pattern=""
else
  echo "pre-push: $denylist is missing, so private names cannot be checked." >&2
  echo "  clone agent-context to ~/.config/agents, or push with DOTFILES_ALLOW_NO_DENYLIST=1" >&2
  exit 1
fi

status=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  if [ -n "$pattern" ]; then
    # shellcheck disable=SC2086 # $range is deliberately split into rev args
    for c in $(git rev-list $range); do
      hits=$( { git log -1 --format=%B "$c"
                git diff-tree -r --root --name-only --no-commit-id "$c"
                git diff-tree -p --root --no-commit-id "$c" | grep -E '^\+[^+]'
              } | grep -inE "$pattern")
      if [ -n "$hits" ]; then
        echo "pre-push: $(git log -1 --format='%h %s' "$c") matches the private denylist:" >&2
        echo "$hits" | cut -c1-160 | sed 's/^/    /' >&2
        status=1
      fi
    done
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --no-banner --redact --log-opts="$range" >&2; then
      status=1
    fi
  fi
done

[ "$status" = 0 ] || echo "pre-push: blocked. Rewrite the commits above before pushing." >&2
exit $status
