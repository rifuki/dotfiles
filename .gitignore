# Ignore everything
*

# Root files
!.gitignore
!README.md
!install.sh
!uninstall.sh

# Shared configs
!shared/
!shared/**

# macOS platform
!macos/
!macos/**

# Ubuntu platform
!ubuntu/
!ubuntu/**

# Gentoo platform
!gentoo/
!gentoo/**

# Ignore specific files
.DS_Store
**/.DS_Store
**/.zcompdump*
**/lazy-lock.json
**/.config/tmux/plugins/
**/*.zwc

# Claude (shared, ignore runtime json files)
shared/.claude/*.json
shared/.claude/*.local.json
!shared/.claude/settings.json
