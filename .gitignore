# Ignore everything
*

# But not these files
!.gitignore
!README.md
!install.sh
!uninstall.sh

# But not folders themselves, so we can whitelist
!*/

# Shared configs
!shared/
!shared/**

# macOS platform
!macos/
!macos/**

# VPS platform
!vps/
!vps/**

# Ignore specific files
.DS_Store
**/.DS_Store
**/lazy-lock.json
**/plugins/
**/*.zwc

# Claude (shared, ignore runtime json files)
shared/.claude/*.json
shared/.claude/*.local.json
