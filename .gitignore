# Ignore everything
*

# But not these files
!.gitignore

# But not folders themselves, so we can whitelist
!*/
!setup*.sh
!uninstall*.sh

# But not nvim and its contents
!nvim/
!nvim/**
# Ignore nvim/lazy-lock.json, but not the directory
nvim/lazy-lock.json

# But not tmux and its contents
!tmux/
!tmux/**
# Ignore tmux/plugins and its contents
tmux/plugins/

# But not spaceship and its contents
!spaceship/
!spaceship/**
