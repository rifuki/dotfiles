# Ignore everything
*

# Root files
!.gitignore
!README.md
!install.sh
!uninstall.sh

# Shared configs
!shared/
!shared/**

# macOS platform
!macos/
!macos/**

# Debian platform
!debian/
!debian/**

# Arch platform
!arch/
!arch/**

# Gentoo platform
!gentoo/
!gentoo/**

# Ignore specific files
.DS_Store
**/.DS_Store
**/.zcompdump*
**/__pycache__/
**/lazy-lock.json
**/.config/tmux/plugins/
**/*.zwc

# Claude (shared, ignore runtime json files)
shared/.claude/*.json
shared/.claude/*.local.json
!shared/.claude/settings.json
