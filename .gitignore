# Ignore everything
*

# Root files
!.gitignore
!.githooks/
!.githooks/**
!README.md
!install.sh
!uninstall.sh

# Shared configs
!shared/
!shared/**

# macOS platform
!macos/
!macos/**

# Linux platforms
!linux/
!linux/**

# Documentation
!docs/
!docs/**

# Ignore specific files
.DS_Store
**/.DS_Store
**/.zcompdump*
**/__pycache__/
**/lazy-lock.json
**/.config/tmux/plugins/
**/*.zwc
**/node_modules/

# Claude (shared, ignore runtime json files)
shared/.claude/*.json
shared/.claude/*.local.json
!shared/.claude/settings.json
!shared/.claude/mcp-servers.json

# Editor and tool backups, never published
**/*.bak
**/*.bak.*
**/*.bak-*

# Sound mute toggles (play.sh), per machine
shared/.claude/sounds/mute
shared/.claude/sounds/*.mute
