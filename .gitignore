# Ignore everything
*

# But not these files
!.gitignore
!README.md

# But not folders themselves, so we can whitelist
!*/
# Ignore unified branch subdirs (not part of this branch)
/shared/
/macos/
/vps/
!install.sh
!uninstall.sh
!.zshrc

# But not .config and its contents
!.config/
!.config/**
# Ignore specific files
.DS_Store
**/.DS_Store
.config/.git/
.config/nvim/lazy-lock.json
.config/tmux/plugins/
*.zwc

# But not .claude and its contents
!.claude/
!.claude/**
.claude/settings.local.json
