#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

os.environ.setdefault("GDK_BACKEND", "wayland")

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk


APP_CLASS = "screenshot-thumbnail"
APP_NAME = "Floating Screenshot"
APP_ICON = "dev.rifuki.ScreenshotFloating"
DEFAULT_WIDTH = 326
DEFAULT_HEIGHT = 246
SWIPE_SAVE_THRESHOLD = 56
DRAG_START_THRESHOLD = 18
SWIPE_VERTICAL_TOLERANCE = 46
SWIPE_DOMINANCE = 1.35
TOUCHPAD_SWIPE_THRESHOLD = 0.85


def notify(summary, body="", icon=None, urgency="low", timeout=1800):
    dunstify = shutil.which("dunstify")
    if not dunstify:
        return
    command = [
        dunstify,
        "-a",
        APP_NAME,
        "-u",
        urgency,
        "-t",
        str(timeout),
        "-h",
        "string:x-dunst-stack-tag:floating-screenshot",
    ]
    if icon:
        command.extend(["-i", str(icon)])
    else:
        command.extend(["-i", APP_ICON])
    command.extend([summary, body])
    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def unique_destination(save_dir):
    stamp = time.strftime("%Y%m%d-%H%M%S")
    candidate = save_dir / f"screenshot-{stamp}.png"
    index = 1
    while candidate.exists():
        candidate = save_dir / f"screenshot-{stamp}-{index}.png"
        index += 1
    return candidate


def scaled_pixbuf(pixbuf, max_width, max_height):
    width = pixbuf.get_width()
    height = pixbuf.get_height()
    scale = min(max_width / width, max_height / height, 1.0)
    out_width = max(1, int(width * scale))
    out_height = max(1, int(height * scale))
    return pixbuf.scale_simple(out_width, out_height, GdkPixbuf.InterpType.BILINEAR)


class ScreenshotThumbnail(Gtk.Window):
    def __init__(self, path, save_dir, timeout, cleanup_after_drag):
        super().__init__(title=APP_CLASS)
        self.path = Path(path).resolve()
        self.save_dir = Path(save_dir).expanduser().resolve()
        self.timeout = max(1, int(timeout))
        self.cleanup_after_drag = max(10, int(cleanup_after_drag))
        self.completed = False
        self.drag_started = False
        self.remaining = self.timeout
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.gesture_button = 1
        self.touchpad_swipe_dx = 0.0

        self.full_pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(self.path))
        self.thumb_pixbuf = scaled_pixbuf(self.full_pixbuf, 292, 148)

        self._configure_window()
        self._build_ui()
        self._connect_events()

        GLib.timeout_add_seconds(1, self.tick)

    def _configure_window(self):
        self.set_title(APP_CLASS)
        self.set_default_size(DEFAULT_WIDTH, DEFAULT_HEIGHT)
        self.set_size_request(DEFAULT_WIDTH, DEFAULT_HEIGHT)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)

        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual() if screen else None
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

    def _build_ui(self):
        css = b"""
        window {
          background-color: transparent;
        }
        #root {
          background-color: rgba(10, 13, 22, 0.88);
          border: 1px solid rgba(205, 214, 244, 0.30);
          border-radius: 18px;
          padding: 9px;
        }
        #title {
          color: #cdd6f4;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.4px;
        }
        #timer {
          color: #0a0e17;
          background-color: #50fa7b;
          border-radius: 999px;
          padding: 2px 7px;
          font-size: 10px;
          font-weight: 700;
        }
        #frame {
          border-radius: 13px;
          border: 1px solid rgba(0, 217, 255, 0.46);
          background-color: rgba(255, 255, 255, 0.07);
          padding: 3px;
        }
        #drag-hint {
          color: rgba(205, 214, 244, 0.80);
          font-size: 10px;
        }
        #hint {
          color: rgba(205, 214, 244, 0.60);
          font-size: 9px;
        }
        progressbar trough {
          min-height: 3px;
          border-radius: 999px;
          background-color: rgba(255, 255, 255, 0.10);
        }
        progressbar progress {
          min-height: 3px;
          border-radius: 999px;
          background-image: linear-gradient(to right, #00d9ff, #ff79c6);
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.event_box = Gtk.EventBox()
        self.event_box.set_visible_window(False)
        self.add(self.event_box)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_name("root")
        self.event_box.add(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.pack_start(header, False, False, 0)

        title = Gtk.Label(label="SCREENSHOT")
        title.set_name("title")
        title.set_halign(Gtk.Align.START)
        header.pack_start(title, True, True, 2)

        self.timer_label = Gtk.Label(label=f"{self.remaining}s")
        self.timer_label.set_name("timer")
        header.pack_start(self.timer_label, False, False, 0)

        self.progress = Gtk.ProgressBar()
        self.progress.set_fraction(1.0)
        root.pack_start(self.progress, False, False, 0)

        self.drag_box = Gtk.EventBox()
        self.drag_box.set_visible_window(False)
        root.pack_start(self.drag_box, True, True, 0)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        frame.set_name("frame")
        frame.set_halign(Gtk.Align.CENTER)
        frame.set_valign(Gtk.Align.CENTER)
        self.drag_box.add(frame)

        image = Gtk.Image.new_from_pixbuf(self.thumb_pixbuf)
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        frame.pack_start(image, True, True, 0)

        hint = Gtk.Label(label="Swipe right to save | drag away to share")
        hint.set_name("drag-hint")
        hint.set_halign(Gtk.Align.CENTER)
        root.pack_start(hint, False, False, 0)

        hint = Gtk.Label(label="Double-click image to edit | Esc discard")
        hint.set_name("hint")
        hint.set_halign(Gtk.Align.CENTER)
        root.pack_start(hint, False, False, 0)

    def _connect_events(self):
        targets = [
            Gtk.TargetEntry.new("text/uri-list", Gtk.TargetFlags.OTHER_APP, 0),
            Gtk.TargetEntry.new("image/png", Gtk.TargetFlags.OTHER_APP, 1),
            Gtk.TargetEntry.new("image/x-png", Gtk.TargetFlags.OTHER_APP, 1),
            Gtk.TargetEntry.new("text/plain", Gtk.TargetFlags.OTHER_APP, 2),
        ]
        self.drag_targets = Gtk.TargetList.new(targets)
        self.drag_box.connect("drag-data-get", self.on_drag_data_get)
        self.drag_box.connect("drag-end", self.on_drag_end)
        self.drag_box.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.SCROLL_MASK
            | Gdk.EventMask.SMOOTH_SCROLL_MASK
        )
        self.drag_box.connect("button-press-event", self.on_preview_press)
        self.drag_box.connect("motion-notify-event", self.on_preview_motion)
        self.drag_box.connect("button-release-event", self.on_preview_release)
        self.drag_box.connect("leave-notify-event", self.on_preview_leave)
        self.drag_box.connect("scroll-event", self.on_preview_scroll)
        self.connect("key-press-event", self.on_key_press)
        self.connect("delete-event", self.on_delete)

    def on_drag_data_get(self, _widget, _context, selection_data, target_info, _time):
        if target_info == 0:
            selection_data.set_uris([self.path.as_uri()])
        elif target_info == 1:
            selection_data.set_pixbuf(self.full_pixbuf)
        else:
            selection_data.set_text(str(self.path), -1)

    def on_drag_end(self, _widget, _context):
        if self.completed:
            return
        self.completed = True
        self.delete_later()
        GLib.timeout_add(700, self.quit)

    def on_preview_press(self, _widget, event):
        if event.button == 3:
            self.discard()
            return True
        if event.type == Gdk.EventType._2BUTTON_PRESS and event.button == 1:
            self.save_and_open()
            return True
        if event.button != 1:
            return False
        self.gesture_start_x = event.x_root
        self.gesture_start_y = event.y_root
        self.gesture_button = event.button
        self.drag_started = False
        return True

    def on_preview_motion(self, widget, event):
        if self.gesture_start_x is None or self.completed:
            return False
        if not (event.state & Gdk.ModifierType.BUTTON1_MASK):
            return False
        dx = event.x_root - self.gesture_start_x
        dy = event.y_root - self.gesture_start_y
        adx = abs(dx)
        ady = abs(dy)

        is_right_swipe = (
            dx >= SWIPE_SAVE_THRESHOLD
            and ady <= SWIPE_VERTICAL_TOLERANCE
            and dx >= ady * SWIPE_DOMINANCE
        )
        if is_right_swipe:
            self.save_now(show_notification=True)
            GLib.timeout_add(80, self.quit)
            return True

        if not self.drag_started and (adx >= DRAG_START_THRESHOLD or ady >= DRAG_START_THRESHOLD):
            self.drag_started = True
            context = widget.drag_begin(
                self.drag_targets,
                Gdk.DragAction.COPY,
                int(self.gesture_button),
                event,
            )
            Gtk.drag_set_icon_pixbuf(context, self.thumb_pixbuf, 8, 8)
        return True

    def on_preview_release(self, _widget, _event):
        if self.gesture_start_x is None:
            return False
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.drag_started = False
        return True

    def on_preview_leave(self, *_args):
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.drag_started = False
        self.touchpad_swipe_dx = 0.0
        return False

    def on_preview_scroll(self, _widget, event):
        if self.completed:
            return True

        dx = 0.0
        if event.direction == Gdk.ScrollDirection.RIGHT:
            dx = 1.0
        elif event.direction == Gdk.ScrollDirection.LEFT:
            dx = -1.0
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, smooth_dx, _smooth_dy = event.get_scroll_deltas()
            if ok:
                dx = smooth_dx

        self.touchpad_swipe_dx += dx
        if abs(self.touchpad_swipe_dx) >= TOUCHPAD_SWIPE_THRESHOLD:
            self.save_now(show_notification=True)
            GLib.timeout_add(80, self.quit)
        return True

    def on_key_press(self, _widget, event):
        key_name = Gdk.keyval_name(event.keyval)
        if key_name == "Escape":
            self.discard()
            return True
        if key_name in ("s", "S"):
            self.save_now(show_notification=True)
            self.quit()
            return True
        if key_name in ("Return", "KP_Enter"):
            self.save_and_open()
            return True
        return False

    def on_delete(self, *_args):
        self.discard()
        return True

    def tick(self):
        if self.completed:
            return False
        self.remaining -= 1
        self.timer_label.set_text(f"{max(self.remaining, 0)}s")
        self.progress.set_fraction(max(self.remaining, 0) / self.timeout)
        if self.remaining > 0:
            return True
        self.auto_save()
        return False

    def auto_save(self):
        if self.completed:
            return False
        self.save_now(show_notification=True)
        self.quit()
        return False

    def save_now(self, show_notification):
        if self.completed and not self.path.exists():
            return None
        self.completed = True
        self.save_dir.mkdir(parents=True, exist_ok=True)
        destination = unique_destination(self.save_dir)
        if self.path.exists():
            shutil.move(str(self.path), str(destination))
        if show_notification:
            notify("Saved to Pictures", str(destination), icon=destination)
        return destination

    def save_and_open(self):
        destination = self.save_now(show_notification=False)
        if destination:
            opener = shutil.which("satty")
            if opener:
                subprocess.Popen([opener, "--filename", str(destination)], start_new_session=True)
            else:
                opener = shutil.which("swappy")
                if opener:
                    subprocess.Popen([opener, "-f", str(destination), "-o", str(destination)], start_new_session=True)
                else:
                    subprocess.Popen(["xdg-open", str(destination)], start_new_session=True)
        self.quit()

    def discard(self):
        if not self.completed and self.path.exists():
            self.path.unlink()
        self.completed = True
        self.quit()

    def delete_later(self):
        cleaner = (
            "import os, sys, time\n"
            "time.sleep(int(sys.argv[1]))\n"
            "try:\n"
            "    os.unlink(sys.argv[2])\n"
            "except FileNotFoundError:\n"
            "    pass\n"
        )
        subprocess.Popen(
            [sys.executable, "-c", cleaner, str(self.cleanup_after_drag), str(self.path)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def quit(self):
        Gtk.main_quit()
        return False


def parse_args():
    parser = argparse.ArgumentParser(description="Floating screenshot thumbnail for Hyprland")
    parser.add_argument("path", help="Temporary screenshot PNG path")
    parser.add_argument("--save-dir", default="~/Pictures/Screenshots")
    parser.add_argument("--timeout", type=int, default=5)
    parser.add_argument("--cleanup-after-drag", type=int, default=120)
    return parser.parse_args()


def main():
    args = parse_args()
    path = Path(args.path)
    if not path.is_file():
        print(f"screenshot-thumbnail: missing file: {path}", file=sys.stderr)
        return 1

    GLib.set_prgname(APP_CLASS)
    Gdk.set_program_class(APP_CLASS)

    win = ScreenshotThumbnail(path, args.save_dir, args.timeout, args.cleanup_after_drag)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
