#!/usr/bin/env bash
# CopyQ clipboard picker: detect clipboard change → hide CopyQ → paste

PREV_ADDR=$(hyprctl activewindow -j | jq -r '.address')
OLD_CLIP=$(copyq clipboard 2>/dev/null; copyq clipboard TIMESTAMP 2>/dev/null)

copyq show
sleep 0.3

# Poll: exit when clipboard changes (user selected item) OR CopyQ window closes
while true; do
    # Window closed manually (Escape etc)
    if ! hyprctl clients -j | jq -e '.[] | select(.class == "com.github.hluk.copyq" and .mapped == true)' > /dev/null 2>&1; then
        break
    fi
    # Clipboard changed = user pressed Enter on an item
    NEW_CLIP=$(copyq clipboard 2>/dev/null; copyq clipboard TIMESTAMP 2>/dev/null)
    if [ "$NEW_CLIP" != "$OLD_CLIP" ]; then
        copyq hide
        break
    fi
    sleep 0.05
done

sleep 0.1
hyprctl dispatch focuswindow "address:$PREV_ADDR"
sleep 0.15
wtype -M ctrl -k v -m ctrl
