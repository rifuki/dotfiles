#!/usr/bin/env bash
# CopyQ clipboard picker: detect clipboard change → hide CopyQ → paste

_clip_hash() { wl-paste 2>/dev/null | sha256sum; }

PREV_ADDR=$(hyprctl activewindow -j | jq -r '.address')
OLD_HASH=$(_clip_hash)

copyq show
sleep 0.3

while true; do
    # Window closed manually (Escape/click outside)
    if ! hyprctl clients -j | jq -e '.[] | select(.class == "com.github.hluk.copyq" and .mapped == true)' > /dev/null 2>&1; then
        break
    fi
    # Clipboard changed = user activated an item (Enter/double-click)
    if [ "$(_clip_hash)" != "$OLD_HASH" ]; then
        copyq hide
        sleep 0.05
        # Force close if copyq hide didn't work
        hyprctl clients -j | jq -e '.[] | select(.class == "com.github.hluk.copyq" and .mapped == true)' > /dev/null 2>&1 && \
            hyprctl dispatch closewindow "class:^(com.github.hluk.copyq)$"
        break
    fi
    sleep 0.05
done

sleep 0.1
hyprctl dispatch focuswindow "address:$PREV_ADDR"
sleep 0.15
wtype -M ctrl -k v -m ctrl
