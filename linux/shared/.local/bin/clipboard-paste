#!/usr/bin/env bash
# CopyQ clipboard picker: open → user picks item → auto-close → restore focus → paste

PREV_ADDR=$(hyprctl activewindow -j | jq -r '.address')

copyq show

# Wait for CopyQ to appear
sleep 0.3

# Wait for CopyQ window to disappear
while hyprctl clients -j | jq -e '.[] | select(.class == "com.github.hluk.copyq" and .mapped == true)' > /dev/null 2>&1; do
    sleep 0.05
done

sleep 0.1
hyprctl dispatch focuswindow "address:$PREV_ADDR"
sleep 0.15
wtype -M ctrl -k v -m ctrl
