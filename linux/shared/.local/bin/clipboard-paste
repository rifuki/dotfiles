#!/usr/bin/env bash
# clipse TUI in floating terminal → select → paste to previous window

PREV_ADDR=$(hyprctl activewindow -j | jq -r '.address')

hyprctl dispatch exec "[float; size 900 500; center] ghostty --class=clipse -e sh -c 'TERM=xterm-kitty $HOME/.local/bin/clipse'"

# Wait for clipse window to appear
for _ in $(seq 40); do
    hyprctl clients -j | jq -e '.[] | select(.class == "clipse")' > /dev/null 2>&1 && break
    sleep 0.05
done

# Wait for clipse window to close
while hyprctl clients -j | jq -e '.[] | select(.class == "clipse")' > /dev/null 2>&1; do
    sleep 0.05
done

sleep 0.1
hyprctl dispatch focuswindow "address:$PREV_ADDR"
sleep 0.15
wtype -M ctrl -k v -m ctrl
