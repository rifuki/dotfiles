#!/usr/bin/env bash
# Toggle zoom: float active window and fill ~95% of workspace (tiled windows stay visible behind)
# Mimics yabai zoom-fullscreen in Hyprland

WINDOW=$(hyprctl activewindow -j)
ADDRESS=$(echo "$WINDOW" | jq -r '.address')
FLOATING=$(echo "$WINDOW" | jq -r '.floating')
STATE_FILE="/tmp/rifuki-zoom-$ADDRESS"

if [[ -f "$STATE_FILE" ]]; then
    rm -f "$STATE_FILE"
    hyprctl dispatch togglefloating
    exit 0
fi

MONITOR_ID=$(echo "$WINDOW" | jq -r '.monitor')
MONITOR=$(hyprctl monitors -j | jq -r ".[] | select(.id == $MONITOR_ID)")
MON_W=$(echo "$MONITOR" | jq -r '.width')
MON_H=$(echo "$MONITOR" | jq -r '.height')
SCALE=$(echo "$MONITOR" | jq -r '.scale')
RESERVED_TOP=$(echo "$MONITOR" | jq -r '.reserved[1]')

W=$(awk "BEGIN {printf \"%d\", ($MON_W / $SCALE) * 0.94}")
H=$(awk "BEGIN {printf \"%d\", ($MON_H / $SCALE - $RESERVED_TOP) * 0.94}")

touch "$STATE_FILE"
[[ "$FLOATING" == "false" ]] && hyprctl dispatch togglefloating
hyprctl dispatch resizeactive exact "$W" "$H"
hyprctl dispatch centerwindow
