## Keybindings
keybind = super+r=reload_config
keybind = super+i=inspector:toggle
# Cmd+1..9: tmux window (Alt is yabai's).
keybind = super+1=text:\x021
keybind = super+2=text:\x022
keybind = super+3=text:\x023
keybind = super+4=text:\x024
keybind = super+5=text:\x025
keybind = super+6=text:\x026
keybind = super+7=text:\x027
keybind = super+8=text:\x028
keybind = super+9=text:\x029

## Font Settings
font-family = JetBrainsMono Nerd Font
font-size = 16
font-thicken = true

## Cursor 
cursor-style = block
cursor-style-blink = true

## Theme & Appearance
theme = TokyoNight Night
background = #000000
background-opacity = 0.65
background-blur-radius = 10

## Window Settings
window-decoration = true
window-padding-x = 15
window-padding-y = 15
window-vsync = true

## macOS-Specific
macos-titlebar-style = hidden
macos-non-native-fullscreen = true

## Shell
shell-integration = zsh

## Behavior
confirm-close-surface = false

term = xterm-256color

