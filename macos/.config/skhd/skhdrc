## Toggle Active Window Opacity
alt + ctrl - o : ~/.local/bin/kz config active_window_opacity $(~/.local/bin/kz config active_window_opacity | grep -q 1.0 && echo 0.95 || echo 1.0)

## Toggle Uniform Opacity (semua window rata opaque, gak ada yang transparan)
alt + ctrl - i : ~/.local/bin/kz config window_opacity $(~/.local/bin/kz config window_opacity | grep -q on && echo off || echo on)

## Toggle Ghostty Background Transparency
alt + ctrl - t : ~/.config/ghostty/toggle-opacity.sh && skhd -k "cmd - r"


## True Fullscreen Above the Notch (kaze-notchfs)
# alt - f = zoom-fullscreen (in-layout). alt + shift - f = true fullscreen that
# covers the menu bar and fills the notch band. Toggle again to restore.
# Works on unhardened apps + Ghostty; not Chrome/Telegram (library validation).
alt + shift - f : ~/.local/src/kaze/scripts/kaze-notchfs

## MacNotchKiller: fullscreen video/app that also fills the area beside the notch
# Toggle on the focused window (e.g. Chrome/YouTube). Leaving fullscreen also exits.
alt + shift - n : ~/.local/bin/notchkiller
