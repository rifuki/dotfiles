## Display Navigation (Focus between monitors)
# skhd tidak menerima ',' '.' mentah -> pakai keycode (0x2B = ',' , 0x2F = '.')
# focus_display.sh: cyclic sesuai posisi FISIK, robust horizontal MAUPUN vertical
# (script juga warp kursor ke monitor tujuan)
alt - 0x2B : ~/.config/kaze/focus_display.sh focus prev   # monitor sebelah (kiri/atas)
alt - 0x2F : ~/.config/kaze/focus_display.sh focus next   # monitor sebelah (kanan/bawah)

## Move Window to Display
alt + shift - 0x2B : ~/.config/kaze/focus_display.sh move prev
alt + shift - 0x2F : ~/.config/kaze/focus_display.sh move next

## Window & Space Layouts
# Toggle between floating and grid layout
alt - return : ~/.local/bin/ume window toggle-float; \
               ~/.local/bin/kz window --grid 20:20:1:1:18:18 
alt + shift - return : ~/.local/bin/ume window toggle-float; \
                       ~/.local/bin/kz window --grid 4:4:1:1:2:2
# Arrange windows in grid
alt + shift - left : ~/.local/bin/kz window --grid 1:2:0:0:1:1
alt + shift - down : ~/.local/bin/kz window --grid 20:20:1:1:18:18
alt + shift - up : ~/.local/bin/kz window --grid 1:1:0:0:1:1
alt + shift - right : ~/.local/bin/kz window --grid 1:2:1:0:1:1

## Zoom & Parent Resize
alt - d : ~/.local/bin/kz window --toggle zoom-parent # Expand inside BSP container

## Rotate (BSP) & Mirror Layouts

## Balance & Split Layout
alt - e : ~/.local/bin/kz window --toggle split ## Toggle horizontal/vertical split

## Toggle Padding & Gaps (Show/Hide window spacing)
alt - a : ~/.local/bin/kz space --toggle padding; ~/.local/bin/kz space --toggle gap

## Space Navigation (Move between workspaces)
alt - tab : ~/.local/bin/kz space --focus recent # Focus last used space
alt - p : ~/.local/bin/kz --space-cycle prev # Prev space (dalam display aktif)
alt - n : ~/.local/bin/kz --space-cycle next # Next space (dalam display aktif)
alt - 1 : ~/.local/bin/kz space --focus 1
alt - 2 : ~/.local/bin/kz space --focus 2
alt - 3 : ~/.local/bin/kz space --focus 3
alt - 4 : ~/.local/bin/kz space --focus 4
alt - 5 : ~/.local/bin/kz space --focus 5
alt - 6 : ~/.local/bin/kz space --focus 6
alt - 7 : ~/.local/bin/kz space --focus 7
alt - 8 : ~/.local/bin/kz space --focus 8
alt - 9 : ~/.local/bin/kz space --focus 9

## Move Window to Space
alt + shift - 1 : ~/.local/bin/kz window --space 1
alt + shift - 2 : ~/.local/bin/kz window --space 2
alt + shift - 3 : ~/.local/bin/kz window --space 3
alt + shift - 4 : ~/.local/bin/kz window --space 4
alt + shift - 5 : ~/.local/bin/kz window --space 5
alt + shift - 6 : ~/.local/bin/kz window --space 6
alt + shift - 7 : ~/.local/bin/kz window --space 7
alt + shift - 8 : ~/.local/bin/kz window --space 8
alt + shift - 9 : ~/.local/bin/kz window --space 9

