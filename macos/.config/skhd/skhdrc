## Window Navigation (Focus & Swap)
# Focus Window (Move between windows)
alt - h : ~/.local/bin/kz window --focus west
alt - j : ~/.config/kaze/focus_window.sh south   # Stack-aware focus down
alt - k : ~/.config/kaze/focus_window.sh north   # Stack-aware focus up
alt - l : ~/.local/bin/kz window --focus east
# Swap Window (Rearrange window positions)
alt + shift - h : ~/.local/bin/kz window --swap west
alt + shift - j : ~/.config/kaze/swap_window.sh south  # Stack-aware swap down
alt + shift - k : ~/.config/kaze/swap_window.sh north  # Stack-aware swap up
alt + shift - l : ~/.local/bin/kz window --swap east

## Window Resizing (Increase/Decrease Size)
# Increase Size
alt + ctrl - h : ~/.local/bin/kz window --resize left:-20:0
alt + ctrl - j : ~/.local/bin/kz window --resize bottom:0:20
alt + ctrl - k : ~/.local/bin/kz window --resize top:0:-20
alt + ctrl - l : ~/.local/bin/kz window --resize right:20:0
# Decrease Size
alt + ctrl + shift - h : ~/.local/bin/kz window --resize left:20:0
alt + ctrl + shift - j : ~/.local/bin/kz window --resize bottom:0:-20
alt + ctrl + shift - k : ~/.local/bin/kz window --resize top:0:20
alt + ctrl + shift - l : ~/.local/bin/kz window --resize right:-20:0

## Display Navigation (Focus between monitors)
# skhd tidak menerima ',' '.' mentah -> pakai keycode (0x2B = ',' , 0x2F = '.')
# focus_display.sh: cyclic sesuai posisi FISIK, robust horizontal MAUPUN vertical
# (script juga warp kursor ke monitor tujuan)
alt - 0x2B : ~/.config/kaze/focus_display.sh focus prev   # monitor sebelah (kiri/atas)
alt - 0x2F : ~/.config/kaze/focus_display.sh focus next   # monitor sebelah (kanan/bawah)

## Move Window to Display
alt + shift - 0x2B : ~/.config/kaze/focus_display.sh move prev
alt + shift - 0x2F : ~/.config/kaze/focus_display.sh move next

## Window & Space Layouts
# Toggle between floating and grid layout
alt - return : ~/.local/bin/kz window --toggle float; \
               ~/.local/bin/kz window --grid 20:20:1:1:18:18 
alt + shift - return : ~/.local/bin/kz window --toggle float; \
                       ~/.local/bin/kz window --grid 4:4:1:1:2:2
# Arrange windows in grid
alt + shift - left : ~/.local/bin/kz window --grid 1:2:0:0:1:1
alt + shift - down : ~/.local/bin/kz window --grid 20:20:1:1:18:18
alt + shift - up : ~/.local/bin/kz window --grid 1:1:0:0:1:1
alt + shift - right : ~/.local/bin/kz window --grid 1:2:1:0:1:1

## Zoom & Parent Resize
alt - f : ~/.local/bin/kz window --toggle zoom-fullscreen
alt - d : ~/.local/bin/kz window --toggle zoom-parent # Expand inside BSP container

## Rotate (BSP) & Mirror Layouts
alt - r : ~/.local/bin/kz space --rotate 270; ~/.local/bin/kz space --balance
alt + shift - r : ~/.local/bin/kz space --rotate 90; ~/.local/bin/kz space --balance
alt - y : ~/.local/bin/kz space --mirror y-axis
alt - x : ~/.local/bin/kz space --mirror x-axis

## Balance & Split Layout
alt + shift - 0 : ~/.local/bin/kz space --balance
alt - e : ~/.local/bin/kz window --toggle split ## Toggle horizontal/vertical split

## Toggle Padding & Gaps (Show/Hide window spacing)
alt - a : ~/.local/bin/kz space --toggle padding; ~/.local/bin/kz space --toggle gap

## Space Navigation (Move between workspaces)
alt - tab : ~/.local/bin/kz space --focus recent # Focus last used space
alt - p : ~/.local/bin/kz --space-cycle prev # Prev space (dalam display aktif)
alt - n : ~/.local/bin/kz --space-cycle next # Next space (dalam display aktif)
alt - 1 : ~/.local/bin/kz space --focus 1
alt - 2 : ~/.local/bin/kz space --focus 2
alt - 3 : ~/.local/bin/kz space --focus 3
alt - 4 : ~/.local/bin/kz space --focus 4
alt - 5 : ~/.local/bin/kz space --focus 5
alt - 6 : ~/.local/bin/kz space --focus 6
alt - 7 : ~/.local/bin/kz space --focus 7
alt - 8 : ~/.local/bin/kz space --focus 8
alt - 9 : ~/.local/bin/kz space --focus 9

## Move Window to Space
alt + shift - 1 : ~/.local/bin/kz window --space 1
alt + shift - 2 : ~/.local/bin/kz window --space 2
alt + shift - 3 : ~/.local/bin/kz window --space 3
alt + shift - 4 : ~/.local/bin/kz window --space 4
alt + shift - 5 : ~/.local/bin/kz window --space 5
alt + shift - 6 : ~/.local/bin/kz window --space 6
alt + shift - 7 : ~/.local/bin/kz window --space 7
alt + shift - 8 : ~/.local/bin/kz window --space 8
alt + shift - 9 : ~/.local/bin/kz window --space 9

## Change Layout Mode
alt + ctrl - z : ~/.local/bin/kz space --layout bsp
alt + ctrl - x : ~/.local/bin/kz space --layout float
alt + ctrl - c : ~/.local/bin/kz space --layout stack

## Toggle Active Window Opacity
alt + ctrl - o : ~/.local/bin/kz config active_window_opacity $(~/.local/bin/kz config active_window_opacity | grep -q 1.0 && echo 0.95 || echo 1.0)

## Toggle Uniform Opacity (semua window rata opaque, gak ada yang transparan)
alt + ctrl - i : ~/.local/bin/kz config window_opacity $(~/.local/bin/kz config window_opacity | grep -q on && echo off || echo on)

## Toggle Ghostty Background Transparency
alt + ctrl - t : ~/.config/ghostty/toggle-opacity.sh && skhd -k "cmd - r"


## True Fullscreen Above the Notch (kaze-notchfs)
# alt - f = zoom-fullscreen (in-layout). alt + shift - f = true fullscreen that
# covers the menu bar and fills the notch band. Toggle again to restore.
# Works on unhardened apps + Ghostty; not Chrome/Telegram (library validation).
alt + shift - f : ~/.local/src/kaze/scripts/kaze-notchfs
