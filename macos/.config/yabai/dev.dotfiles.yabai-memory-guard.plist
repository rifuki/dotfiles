<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.yabai-memory-guard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.config/yabai/memory-guard.sh</string>
  </array>

  <!-- Every 30 minutes. The guard is a couple of ps calls when yabai is behaving,
       so the interval costs nothing and bounds the leak at ~65 MB of overshoot. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardErrorPath</key>
  <string>/tmp/yabai-memory-guard.err</string>
</dict>
</plist>
