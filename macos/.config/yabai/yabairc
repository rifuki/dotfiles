## Necessary Setup
# --load-sa restarts Dock to inject the payload, which means the SA is briefly
# down while the rest of this file runs. Settings that need it are in
# sa_config.sh and get re-applied once Dock is back -- see that file for why.
sudo yabai --load-sa  # Load scripting addition
yabai -m signal --add event=dock_did_restart \
  action="sudo yabai --load-sa && $HOME/.config/yabai/sa_config.sh" \
  label=reload_sa

## Signals
# Window Ghostty baru muncul di monitor tempat kursor aktif (bukan main display).
# Matiin animasi sesaat -> teleport instan (tanpa slide) -> balikin ke 0.2.
# (Batasan: 1 frame kedip di display utama gak bisa dihindari, macOS render duluan.)
yabai -m signal --add event=window_created app="^Ghostty$" \
  action='yabai -m config window_animation_duration 0.0; yabai -m window $YABAI_WINDOW_ID --display mouse --focus; yabai -m config window_animation_duration 0.2' \
  label=ghostty_follow_mouse

## Layout & Placement
yabai -m config layout bsp  # Use BSP layout
yabai -m config window_placement second_child   # New windows as second child

## Mouse Controls
yabai -m config mouse_modifier alt  # Hold Alt for mouse options
yabai -m config mouse_action1 move      # default
yabai -m config mouse_action2 resize    # default
yabai -m config mouse_drop_action swap  # default
# focus_follows_mouse lives in sa_config.sh -- it needs the scripting addition
# yabai -m config mouse_follows_focus on

## Padding & Gaps
yabai -m config left_padding 10
yabai -m config bottom_padding 10
yabai -m config top_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 10

## Window Configs
# The window_opacity family lives in sa_config.sh -- it needs the scripting addition.
# window_topmost was dropped in yabai v7 and errored on every boot:
#   unknown command 'window_topmost' for domain 'config'
# The per-window replacement is `--sub-layer above` (or a rule with sub-layer=above).
# This was set to the default, so there is nothing to carry over.
yabai -m config window_animation_duration 0.2
yabai -m config window_animation_easing   ease_out_quint
yabai -m config window_shadow             on

## Disable Window Management for Specific Apps
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="Music" title="MiniPlayer" manage=off
yabai -m rule --add app="Calculator" manage=off
yabai -m rule --add app="Raycast" manage=off
yabai -m rule --add app="CleanMyMac X" manage=off
yabai -m rule --add app="Google Chrome" title="(MetaMask.*|Keplr.*|HaHa.*|.*Wallet.*)" manage=off

## Scripting-addition config
# Applied last so the SA has had the whole file to come back up after --load-sa.
# Re-applied by the dock_did_restart signal as well.
"$HOME/.config/yabai/sa_config.sh"
