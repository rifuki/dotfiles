<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rifuki.mousecape-miku</string>

	<!-- Cursor registration is per-session and does not survive a reboot, so apply the
	     cape once at login. The job exits immediately afterwards.

	     Deliberately NOT `mousecloak listen`. That subcommand stays resident to
	     re-apply the cape on fast user switch, but it runs an AppKit loop, so
	     LaunchServices gives it a Dock tile — with no window to open and KeepAlive
	     restarting it on every quit. Moving the binary out of the app bundle does not
	     help; it still registers, just under the name "mousecloak". Only an
	     LSUIElement bundle would hide it, which is not worth carrying for fast user
	     switching alone. If the cursor ever does revert:

	         launchctl kickstart gui/$(id -u)/com.rifuki.mousecape-miku

	     $HOME is expanded by /bin/sh at run time, not by launchd, so this plist is
	     portable and needs no path substitution at install. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>"$HOME/.local/libexec/mousecloak" apply "$HOME/Library/Application Support/Mousecape/capes/miku-cursor.cape" --suppress-copyright</string>
	</array>

	<!-- No KeepAlive: this is a one-shot job, and KeepAlive would respawn it forever. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/mousecape-miku.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/mousecape-miku.log</string>
</dict>
</plist>
