#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

os.environ.setdefault("GDK_BACKEND", "wayland,x11")

try:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk
except Exception as exc:
    print(
        "floating-screenshot: Python GTK bindings are required. "
        "Install PyGObject + GTK3 introspection packages.",
        file=sys.stderr,
    )
    print(f"floating-screenshot: {exc}", file=sys.stderr)
    raise SystemExit(78)


APP_CLASS = "floating-screenshot"
APP_NAME = "Floating Screenshot"
APP_ICON = "dev.rifuki.FloatingScreenshot"
DEFAULT_WIDTH = 326
DEFAULT_HEIGHT = 246
SWIPE_SAVE_THRESHOLD = 56
SWIPE_DISMISS_THRESHOLD = 56
DRAG_START_THRESHOLD = 18
SWIPE_VERTICAL_TOLERANCE = 46
SWIPE_DOMINANCE = 1.35
TOUCHPAD_SWIPE_THRESHOLD = 0.85
CANCELLED = object()


class CaptureError(Exception):
    pass


def command_exists(command):
    return shutil.which(command) is not None


def run(args, *, input_bytes=None, capture_output=False):
    return subprocess.run(
        args,
        input=input_bytes,
        stdout=subprocess.PIPE if capture_output else subprocess.DEVNULL,
        stderr=subprocess.PIPE if capture_output else subprocess.DEVNULL,
        check=False,
    )


def apply_hyprland_rules():
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or not command_exists("hyprctl"):
        return

    # Wayland clients cannot position their own toplevel windows. On Hyprland,
    # runtime window rules make the standalone app behave like macOS thumbnails
    # without requiring the user to edit hyprland.conf.
    rules = [
        f"float,class:^({APP_CLASS})$",
        f"pin,class:^({APP_CLASS})$",
        f"size {DEFAULT_WIDTH} {DEFAULT_HEIGHT},class:^({APP_CLASS})$",
        f"move onscreen 100%-w-24 77%,class:^({APP_CLASS})$",
        f"float,title:^({APP_CLASS})$",
        f"pin,title:^({APP_CLASS})$",
        f"size {DEFAULT_WIDTH} {DEFAULT_HEIGHT},title:^({APP_CLASS})$",
        f"move onscreen 100%-w-24 77%,title:^({APP_CLASS})$",
    ]
    for rule in rules:
        subprocess.run(
            ["hyprctl", "keyword", "windowrule", rule],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def notify(summary, body="", icon=None, urgency="low", timeout=1800, enabled=True):
    if not enabled:
        return

    if command_exists("dunstify"):
        command = [
            "dunstify",
            "-a",
            APP_NAME,
            "-u",
            urgency,
            "-t",
            str(timeout),
            "-h",
            "string:x-dunst-stack-tag:floating-screenshot",
        ]
        command.extend(["-i", str(icon or APP_ICON)])
        command.extend([summary, body])
    elif command_exists("notify-send"):
        command = ["notify-send", "-a", APP_NAME, "-t", str(timeout)]
        if icon:
            command.extend(["-i", str(icon)])
        command.extend([summary, body])
    else:
        return

    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def xdg_pictures_dir():
    if command_exists("xdg-user-dir"):
        result = run(["xdg-user-dir", "PICTURES"], capture_output=True)
        if result.returncode == 0:
            value = result.stdout.decode().strip()
            if value:
                return Path(value)
    return Path.home() / "Pictures"


def default_tmp_dir():
    user = os.environ.get("USER") or "user"
    candidates = [
        Path(os.environ.get("XDG_RUNTIME_DIR", "")) / "floating-screenshot",
        Path("/var/tmp") / f"{user}-floating-screenshot",
        Path(tempfile.gettempdir()) / f"{user}-floating-screenshot",
    ]
    for candidate in candidates:
        if not str(candidate):
            continue
        try:
            candidate.mkdir(parents=True, exist_ok=True)
            candidate.chmod(0o700)
            return candidate
        except OSError:
            continue
    raise CaptureError("Could not create a temporary screenshot directory")


def unique_destination(save_dir):
    stamp = time.strftime("%Y%m%d-%H%M%S")
    candidate = save_dir / f"screenshot-{stamp}.png"
    index = 1
    while candidate.exists():
        candidate = save_dir / f"screenshot-{stamp}-{index}.png"
        index += 1
    return candidate


def scaled_pixbuf(pixbuf, max_width, max_height):
    width = pixbuf.get_width()
    height = pixbuf.get_height()
    scale = min(max_width / width, max_height / height, 1.0)
    out_width = max(1, int(width * scale))
    out_height = max(1, int(height * scale))
    return pixbuf.scale_simple(out_width, out_height, GdkPixbuf.InterpType.BILINEAR)


def copy_clipboard(path):
    data = path.read_bytes()
    if os.environ.get("WAYLAND_DISPLAY") and command_exists("wl-copy"):
        return run(["wl-copy", "--type", "image/png"], input_bytes=data).returncode == 0
    if os.environ.get("DISPLAY") and command_exists("xclip"):
        return run(["xclip", "-selection", "clipboard", "-t", "image/png", "-i"], input_bytes=data).returncode == 0
    if command_exists("wl-copy"):
        return run(["wl-copy", "--type", "image/png"], input_bytes=data).returncode == 0
    if command_exists("xclip"):
        return run(["xclip", "-selection", "clipboard", "-t", "image/png", "-i"], input_bytes=data).returncode == 0
    return False


def capture_grim(mode, path):
    if not command_exists("grim"):
        raise CaptureError("grim is not installed")
    if mode == "area":
        if not command_exists("slurp"):
            raise CaptureError("slurp is not installed")
        selection = run(["slurp"], capture_output=True)
        if selection.returncode != 0:
            return CANCELLED
        geometry = selection.stdout.decode().strip()
        if not geometry:
            return CANCELLED
        result = run(["grim", "-g", geometry, str(path)])
    else:
        result = run(["grim", str(path)])
    if result.returncode != 0:
        raise CaptureError("grim failed to capture the screen")
    return path


def capture_maim(mode, path):
    if not command_exists("maim"):
        raise CaptureError("maim is not installed")
    command = ["maim"]
    if mode == "area":
        command.append("-s")
    command.append(str(path))
    result = run(command)
    if result.returncode != 0:
        return CANCELLED if mode == "area" else (_raise("maim failed to capture the screen"))
    return path


def capture_gnome(mode, path):
    if not command_exists("gnome-screenshot"):
        raise CaptureError("gnome-screenshot is not installed")
    command = ["gnome-screenshot"]
    if mode == "area":
        command.append("-a")
    command.extend(["-f", str(path)])
    result = run(command)
    if result.returncode != 0:
        return CANCELLED if mode == "area" else (_raise("gnome-screenshot failed to capture the screen"))
    return path


def capture_spectacle(mode, path):
    if not command_exists("spectacle"):
        raise CaptureError("spectacle is not installed")
    command = ["spectacle", "-b", "-n"]
    if mode == "area":
        command.append("-r")
    command.extend(["-o", str(path)])
    result = run(command)
    if result.returncode != 0:
        return CANCELLED if mode == "area" else (_raise("spectacle failed to capture the screen"))
    return path


def capture_imagemagick(mode, path):
    if command_exists("import"):
        command = ["import"]
    elif command_exists("magick"):
        command = ["magick", "import"]
    else:
        raise CaptureError("ImageMagick import is not installed")

    if mode == "full":
        command.extend(["-window", "root"])
    command.append(str(path))
    result = run(command)
    if result.returncode != 0:
        return CANCELLED if mode == "area" else (_raise("ImageMagick import failed to capture the screen"))
    return path


def _raise(message):
    raise CaptureError(message)


CAPTURE_BACKENDS = {
    "grim": capture_grim,
    "maim": capture_maim,
    "gnome": capture_gnome,
    "spectacle": capture_spectacle,
    "imagemagick": capture_imagemagick,
}


def auto_backends():
    backends = []
    if os.environ.get("WAYLAND_DISPLAY"):
        backends.extend(["grim", "gnome", "spectacle"])
    if os.environ.get("DISPLAY"):
        backends.extend(["maim", "imagemagick"])
    backends.extend(["grim", "maim", "gnome", "spectacle", "imagemagick"])
    deduped = []
    for backend in backends:
        if backend not in deduped:
            deduped.append(backend)
    return deduped


def capture(mode, path, backend):
    candidates = auto_backends() if backend == "auto" else [backend]
    errors = []
    for candidate in candidates:
        handler = CAPTURE_BACKENDS[candidate]
        try:
            result = handler(mode, path)
        except CaptureError as exc:
            errors.append(f"{candidate}: {exc}")
            continue
        if result is CANCELLED:
            return CANCELLED
        if path.exists() and path.stat().st_size > 0:
            return path
        errors.append(f"{candidate}: output file was empty")
    raise CaptureError("No screenshot backend worked. " + "; ".join(errors))


class Thumbnail(Gtk.Window):
    def __init__(self, path, save_dir, timeout, cleanup_after_drag, notifications):
        super().__init__(title=APP_CLASS)
        self.path = Path(path).resolve()
        self.save_dir = Path(save_dir).expanduser().resolve()
        self.timeout = max(1, int(timeout))
        self.cleanup_after_drag = max(10, int(cleanup_after_drag))
        self.notifications = notifications
        self.completed = False
        self.remaining = self.timeout
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.gesture_button = 1
        self.drag_started = False
        self.touchpad_swipe_dx = 0.0

        self.full_pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(self.path))
        self.thumb_pixbuf = scaled_pixbuf(self.full_pixbuf, 292, 148)

        self.configure_window()
        self.build_ui()
        self.connect_events()
        GLib.timeout_add_seconds(1, self.tick)

    def configure_window(self):
        self.set_title(APP_CLASS)
        self.set_default_size(DEFAULT_WIDTH, DEFAULT_HEIGHT)
        self.set_size_request(DEFAULT_WIDTH, DEFAULT_HEIGHT)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(True)
        self.set_focus_on_map(True)
        self.stick()
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)

        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual() if screen else None
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

    def build_ui(self):
        css = b"""
        window { background-color: transparent; }
        #root {
          background-color: rgba(10, 13, 22, 0.88);
          border: 1px solid rgba(205, 214, 244, 0.30);
          border-radius: 18px;
          padding: 9px;
        }
        #title {
          color: #cdd6f4;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.4px;
        }
        #timer {
          color: #0a0e17;
          background-color: #50fa7b;
          border-radius: 999px;
          padding: 2px 7px;
          font-size: 10px;
          font-weight: 700;
        }
        #clip-button {
          color: #0a0e17;
          background-color: #8bd5ff;
          border-radius: 999px;
          padding: 2px 7px;
          font-size: 10px;
          font-weight: 800;
        }
        #frame {
          border-radius: 13px;
          border: 1px solid rgba(0, 217, 255, 0.46);
          background-color: rgba(255, 255, 255, 0.07);
          padding: 3px;
        }
        #drag-hint {
          color: rgba(205, 214, 244, 0.80);
          font-size: 10px;
        }
        #hint {
          color: rgba(205, 214, 244, 0.60);
          font-size: 9px;
        }
        progressbar trough {
          min-height: 3px;
          border-radius: 999px;
          background-color: rgba(255, 255, 255, 0.10);
        }
        progressbar progress {
          min-height: 3px;
          border-radius: 999px;
          background-image: linear-gradient(to right, #00d9ff, #ff79c6);
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.event_box = Gtk.EventBox()
        self.event_box.set_visible_window(False)
        self.add(self.event_box)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_name("root")
        self.event_box.add(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.pack_start(header, False, False, 0)

        title = Gtk.Label(label="SCREENSHOT")
        title.set_name("title")
        title.set_halign(Gtk.Align.START)
        header.pack_start(title, True, True, 2)

        clip_button = Gtk.Button(label="CLIP")
        clip_button.set_name("clip-button")
        clip_button.set_tooltip_text("Dismiss preview and keep screenshot only in clipboard/temp")
        clip_button.connect("clicked", self.on_clip_button)
        header.pack_start(clip_button, False, False, 0)

        self.timer_label = Gtk.Label(label=f"{self.remaining}s")
        self.timer_label.set_name("timer")
        header.pack_start(self.timer_label, False, False, 0)

        self.progress = Gtk.ProgressBar()
        self.progress.set_fraction(1.0)
        root.pack_start(self.progress, False, False, 0)

        self.drag_box = Gtk.EventBox()
        self.drag_box.set_visible_window(False)
        root.pack_start(self.drag_box, True, True, 0)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        frame.set_name("frame")
        frame.set_halign(Gtk.Align.CENTER)
        frame.set_valign(Gtk.Align.CENTER)
        self.drag_box.add(frame)

        image = Gtk.Image.new_from_pixbuf(self.thumb_pixbuf)
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        frame.pack_start(image, True, True, 0)

        hint = Gtk.Label(label="Swipe right save | swipe left/CLIP clipboard only")
        hint.set_name("drag-hint")
        hint.set_halign(Gtk.Align.CENTER)
        root.pack_start(hint, False, False, 0)

        footer = Gtk.Label(label="Drag away to share temp | double-click edit")
        footer.set_name("hint")
        footer.set_halign(Gtk.Align.CENTER)
        root.pack_start(footer, False, False, 0)

    def connect_events(self):
        targets = [
            Gtk.TargetEntry.new("text/uri-list", Gtk.TargetFlags.OTHER_APP, 0),
            Gtk.TargetEntry.new("image/png", Gtk.TargetFlags.OTHER_APP, 1),
            Gtk.TargetEntry.new("image/x-png", Gtk.TargetFlags.OTHER_APP, 1),
            Gtk.TargetEntry.new("text/plain", Gtk.TargetFlags.OTHER_APP, 2),
        ]
        self.drag_targets = Gtk.TargetList.new(targets)
        self.drag_box.connect("drag-data-get", self.on_drag_data_get)
        self.drag_box.connect("drag-end", self.on_drag_end)
        self.drag_box.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.SCROLL_MASK
            | Gdk.EventMask.SMOOTH_SCROLL_MASK
        )
        self.drag_box.connect("button-press-event", self.on_preview_press)
        self.drag_box.connect("motion-notify-event", self.on_preview_motion)
        self.drag_box.connect("button-release-event", self.on_preview_release)
        self.drag_box.connect("leave-notify-event", self.on_preview_leave)
        self.drag_box.connect("scroll-event", self.on_preview_scroll)

        self.connect("key-press-event", self.on_key_press)
        self.connect("delete-event", self.on_delete)

    def on_clip_button(self, _button):
        self.clipboard_only(show_notification=True)

    def on_drag_data_get(self, _widget, _context, selection_data, target_info, _time):
        if target_info == 0:
            selection_data.set_uris([self.path.as_uri()])
        elif target_info == 1:
            selection_data.set_pixbuf(self.full_pixbuf)
        else:
            selection_data.set_text(str(self.path), -1)

    def on_drag_end(self, _widget, _context):
        if self.completed:
            return
        self.completed = True
        self.delete_later()
        GLib.timeout_add(700, self.quit)

    def on_preview_press(self, _widget, event):
        if event.button == 3:
            self.clipboard_only(show_notification=True)
            return True
        if event.type == Gdk.EventType._2BUTTON_PRESS and event.button == 1:
            self.save_and_open()
            return True
        if event.button != 1:
            return False
        self.gesture_start_x = event.x_root
        self.gesture_start_y = event.y_root
        self.gesture_button = event.button
        self.drag_started = False
        return True

    def on_preview_motion(self, widget, event):
        if self.gesture_start_x is None or self.completed:
            return False
        if not (event.state & Gdk.ModifierType.BUTTON1_MASK):
            return False
        dx = event.x_root - self.gesture_start_x
        dy = event.y_root - self.gesture_start_y
        adx = abs(dx)
        ady = abs(dy)

        is_right_swipe = (
            dx >= SWIPE_SAVE_THRESHOLD
            and ady <= SWIPE_VERTICAL_TOLERANCE
            and dx >= ady * SWIPE_DOMINANCE
        )
        if is_right_swipe:
            self.save_now(show_notification=True)
            GLib.timeout_add(80, self.quit)
            return True

        is_left_swipe = (
            dx <= -SWIPE_DISMISS_THRESHOLD
            and ady <= SWIPE_VERTICAL_TOLERANCE
            and abs(dx) >= ady * SWIPE_DOMINANCE
        )
        if is_left_swipe:
            self.clipboard_only(show_notification=True)
            GLib.timeout_add(80, self.quit)
            return True

        if not self.drag_started and (adx >= DRAG_START_THRESHOLD or ady >= DRAG_START_THRESHOLD):
            self.drag_started = True
            context = widget.drag_begin(
                self.drag_targets,
                Gdk.DragAction.COPY,
                int(self.gesture_button),
                event,
            )
            Gtk.drag_set_icon_pixbuf(context, self.thumb_pixbuf, 8, 8)
        return True

    def on_preview_release(self, _widget, _event):
        if self.gesture_start_x is None:
            return False
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.drag_started = False
        return True

    def on_preview_leave(self, *_args):
        self.gesture_start_x = None
        self.gesture_start_y = None
        self.drag_started = False
        self.touchpad_swipe_dx = 0.0
        return False

    def on_preview_scroll(self, _widget, event):
        if self.completed:
            return True

        dx = 0.0
        if event.direction == Gdk.ScrollDirection.RIGHT:
            dx = 1.0
        elif event.direction == Gdk.ScrollDirection.LEFT:
            dx = -1.0
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, smooth_dx, _smooth_dy = event.get_scroll_deltas()
            if ok:
                dx = smooth_dx

        self.touchpad_swipe_dx += dx
        if self.touchpad_swipe_dx >= TOUCHPAD_SWIPE_THRESHOLD:
            self.save_now(show_notification=True)
            GLib.timeout_add(80, self.quit)
        elif self.touchpad_swipe_dx <= -TOUCHPAD_SWIPE_THRESHOLD:
            self.clipboard_only(show_notification=True)
            GLib.timeout_add(80, self.quit)
        return True

    def on_key_press(self, _widget, event):
        key_name = Gdk.keyval_name(event.keyval)
        if key_name == "Escape":
            self.clipboard_only(show_notification=True)
            return True
        if key_name in ("Delete", "BackSpace"):
            self.discard()
            return True
        if key_name in ("s", "S"):
            self.save_now(show_notification=False)
            self.quit()
            return True
        if key_name in ("Return", "KP_Enter"):
            self.save_and_open()
            return True
        return False

    def on_delete(self, *_args):
        self.clipboard_only(show_notification=False)
        return True

    def tick(self):
        if self.completed:
            return False
        self.remaining -= 1
        self.timer_label.set_text(f"{max(self.remaining, 0)}s")
        self.progress.set_fraction(max(self.remaining, 0) / self.timeout)
        if self.remaining > 0:
            return True
        self.auto_save()
        return False

    def auto_save(self):
        if self.completed:
            return False
        self.save_now(show_notification=True)
        self.quit()
        return False

    def save_now(self, show_notification):
        if self.completed and not self.path.exists():
            return None
        self.completed = True
        self.save_dir.mkdir(parents=True, exist_ok=True)
        destination = unique_destination(self.save_dir)
        if self.path.exists():
            shutil.move(str(self.path), str(destination))
        if show_notification:
            notify("Saved to Pictures", str(destination), icon=destination, enabled=self.notifications)
        return destination

    def save_and_open(self):
        destination = self.save_now(show_notification=False)
        if destination:
            if command_exists("satty"):
                subprocess.Popen(["satty", "--filename", str(destination)], start_new_session=True)
            elif command_exists("swappy"):
                subprocess.Popen(["swappy", "-f", str(destination), "-o", str(destination)], start_new_session=True)
            else:
                subprocess.Popen(["xdg-open", str(destination)], start_new_session=True)
        self.quit()

    def discard(self):
        if not self.completed and self.path.exists():
            self.path.unlink()
        self.completed = True
        self.quit()

    def clipboard_only(self, show_notification):
        if self.completed:
            return
        self.completed = True
        if self.path.exists():
            self.delete_later()
        if show_notification:
            notify(
                "Kept in Clipboard",
                "Preview dismissed; not saved to Pictures",
                enabled=self.notifications,
            )
        self.quit()

    def delete_later(self):
        cleaner = (
            "import os, sys, time\n"
            "time.sleep(int(sys.argv[1]))\n"
            "try:\n"
            "    os.unlink(sys.argv[2])\n"
            "except FileNotFoundError:\n"
            "    pass\n"
        )
        subprocess.Popen(
            [sys.executable, "-c", cleaner, str(self.cleanup_after_drag), str(self.path)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def quit(self):
        Gtk.main_quit()
        return False


def print_check():
    print("floating-screenshot dependency check")
    print(f"Python: {sys.version.split()[0]}")
    print("GTK: ok")
    print("")
    for command in [
        "grim",
        "slurp",
        "wl-copy",
        "maim",
        "xclip",
        "gnome-screenshot",
        "spectacle",
        "import",
        "dunstify",
        "notify-send",
    ]:
        status = "ok" if command_exists(command) else "missing"
        print(f"{command:17} {status}")
    print("")
    print(f"WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}")
    print(f"DISPLAY={os.environ.get('DISPLAY', '')}")


def parse_args():
    parser = argparse.ArgumentParser(description="macOS-style floating screenshot thumbnails for Linux")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--area", action="store_true", help="capture selected area (default)")
    mode.add_argument("--full", action="store_true", help="capture full screen")
    parser.add_argument(
        "--backend",
        choices=["auto", "grim", "maim", "gnome", "spectacle", "imagemagick"],
        default="auto",
        help="screenshot backend",
    )
    parser.add_argument("--save-dir", default=str(xdg_pictures_dir() / "Screenshots"))
    parser.add_argument("--tmp-dir", default=None)
    parser.add_argument("--timeout", type=int, default=5)
    parser.add_argument("--cleanup-after-drag", type=int, default=120)
    parser.add_argument("--no-clipboard", action="store_true")
    parser.add_argument("--no-notify", action="store_true")
    parser.add_argument("--thumbnail", metavar="PNG", help="show thumbnail for an existing PNG")
    parser.add_argument("--check", action="store_true", help="print dependency/backend status")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.check:
        print_check()
        return 0

    mode = "full" if args.full else "area"
    save_dir = Path(args.save_dir).expanduser()
    tmp_dir = Path(args.tmp_dir).expanduser() if args.tmp_dir else default_tmp_dir()
    tmp_dir.mkdir(parents=True, exist_ok=True)
    tmp_dir.chmod(0o700)

    if args.thumbnail:
        screenshot = Path(args.thumbnail).expanduser().resolve()
        if not screenshot.is_file():
            print(f"floating-screenshot: missing file: {screenshot}", file=sys.stderr)
            return 2
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        handle = tempfile.NamedTemporaryFile(
            prefix=f"screenshot-{stamp}-",
            suffix=".png",
            dir=tmp_dir,
            delete=False,
        )
        screenshot = Path(handle.name)
        handle.close()
        try:
            result = capture(mode, screenshot, args.backend)
        except CaptureError as exc:
            screenshot.unlink(missing_ok=True)
            notify("Screenshot failed", str(exc), urgency="critical", timeout=3500, enabled=not args.no_notify)
            print(f"floating-screenshot: {exc}", file=sys.stderr)
            return 1
        if result is CANCELLED:
            screenshot.unlink(missing_ok=True)
            return 0
        if not args.no_clipboard and not copy_clipboard(screenshot):
            notify(
                "Screenshot captured",
                "Clipboard copy failed; thumbnail is still available",
                enabled=not args.no_notify,
            )

    GLib.set_prgname(APP_CLASS)
    Gdk.set_program_class(APP_CLASS)
    apply_hyprland_rules()
    window = Thumbnail(
        screenshot,
        save_dir,
        args.timeout,
        args.cleanup_after_drag,
        notifications=not args.no_notify,
    )
    window.show_all()
    window.present()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
