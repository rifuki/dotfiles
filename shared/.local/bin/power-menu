#!/usr/bin/env python3
import json
import os
import signal
import subprocess
import sys

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk
except Exception as exc:
    print(f"power-menu: GTK unavailable: {exc}", file=sys.stderr)
    sys.exit(1)


ACTIONS = [
    ("Lock", ["hyprlock"]),
    ("Suspend", ["systemctl", "suspend"]),
    ("Reboot", ["systemctl", "reboot"]),
    ("Power off", ["systemctl", "poweroff"]),
    ("Logout Hyprland", ["hyprctl", "dispatch", "exit"]),
]


def close_existing_window(class_name):
    try:
        result = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
        clients = json.loads(result.stdout or "[]")
    except Exception:
        return False
    for client in clients:
        if client.get("class") != class_name or client.get("pid") == os.getpid():
            continue
        pid = client.get("pid")
        if pid:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass
        elif client.get("address"):
            subprocess.run(["hyprctl", "dispatch", "closewindow", f"address:{client['address']}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False


def load_css():
    css = b"""
    window { background: rgba(5, 8, 14, 0.97); color: #e5edf6; }
    .shell-frame { padding: 16px; }
    .title { font-size: 22px; font-weight: 900; color: #c4b5fd; }
    .subtitle { color: #94a3b8; }
    button { min-height: 48px; border-radius: 16px; padding: 10px 14px; background: rgba(15, 23, 42, 0.74); border: 1px solid rgba(148, 163, 184, 0.18); color: #e5edf6; font-weight: 800; }
    button:hover { background: rgba(30, 41, 59, 0.94); border-color: rgba(196, 181, 253, 0.46); }
    .danger { color: #fecdd3; border-color: rgba(248, 113, 113, 0.28); }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


class PowerMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title="Power")
        self.set_default_size(360, 370)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.connect("key-press-event", self.close_on_key)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        frame.get_style_context().add_class("shell-frame")
        self.add(frame)

        title = Gtk.Label(label="Power", xalign=0)
        title.get_style_context().add_class("title")
        frame.pack_start(title, False, False, 0)
        subtitle = Gtk.Label(label="Esc, q, or w closes this menu", xalign=0)
        subtitle.get_style_context().add_class("subtitle")
        frame.pack_start(subtitle, False, False, 0)

        for label, command in ACTIONS:
            button = Gtk.Button(label=label)
            button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            if label in {"Reboot", "Power off", "Logout Hyprland"}:
                button.get_style_context().add_class("danger")
            button.connect("button-press-event", self.run_action, command)
            frame.pack_start(button, False, False, 0)

    def run_action(self, _button, event, command):
        if getattr(event, "button", 1) != 1:
            return False
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        Gtk.main_quit()
        return True

    def close_on_key(self, _window, event):
        key_name = Gdk.keyval_name(event.keyval)
        if key_name in {"Escape", "q", "Q", "w", "W"}:
            Gtk.main_quit()
            return True
        return False


def main():
    if close_existing_window("power-menu"):
        return
    load_css()
    window = PowerMenu()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
