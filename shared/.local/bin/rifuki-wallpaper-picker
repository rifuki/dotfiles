#!/usr/bin/env python3
import os
import json
import subprocess
import sys
import time
from pathlib import Path

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, Gtk
except Exception as exc:
    print(f"rifuki-wallpaper-picker: GTK unavailable: {exc}", file=sys.stderr)
    sys.exit(1)


EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
SEARCH_DIRS = [
    Path.home() / ".wallpapers",
    Path.home() / "Pictures" / "Wallpapers",
    Path("/usr/share/backgrounds"),
]
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "rifuki-shell"
LOG_FILE = STATE_DIR / "actions.log"
BIN_DIR = Path.home() / ".local/bin"
WALLPAPER_SET = BIN_DIR / "rifuki-wallpaper-set"
WALLPAPER_NEXT = BIN_DIR / "rifuki-wallpaper-next"


def log(message):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} wallpaper-picker: {message}\n")


def load_css():
    css = b"""
    window { background: rgba(5, 8, 14, 0.98); color: #e5edf6; }
    .shell-frame { padding: 18px; }
    .title { font-size: 20px; font-weight: 800; color: #a7f3d0; }
    .subtitle { color: #94a3b8; }
    searchentry { min-height: 40px; border-radius: 14px; }
    button { border-radius: 14px; padding: 10px; background: rgba(15, 23, 42, 0.72); border: 1px solid rgba(148, 163, 184, 0.18); }
    button:hover { background: rgba(30, 41, 59, 0.92); border-color: rgba(167, 243, 208, 0.36); }
    .wallpaper-name { font-weight: 800; color: #e5edf6; }
    .wallpaper-path { color: #94a3b8; }
    .next-button { color: #0b1220; background: linear-gradient(135deg, #a7f3d0, #8bd5ff); }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def iter_wallpapers():
    seen = set()
    for root in SEARCH_DIRS:
        if not root.is_dir():
            continue
        for current, dirs, files in os.walk(root):
            current_path = Path(current)
            try:
                depth = len(current_path.relative_to(root).parts)
            except ValueError:
                depth = 0
            if depth >= 2:
                dirs[:] = []
            for filename in files:
                path = current_path / filename
                if path.suffix.lower() not in EXTENSIONS:
                    continue
                real = str(path.resolve())
                if real in seen:
                    continue
                seen.add(real)
                yield Path(real)


def notify(title, body):
    for cmd in ("dunstify", "notify-send"):
        if subprocess.run(["sh", "-lc", f"command -v {cmd}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.Popen([cmd, title, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


def focus_existing_picker():
    try:
        result = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
        clients = json.loads(result.stdout or "[]")
    except Exception:
        return False
    for client in clients:
        if client.get("class") != "rifuki-wallpaper-picker":
            continue
        if client.get("pid") == os.getpid():
            continue
        address = client.get("address")
        if address:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", "class:rifuki-wallpaper-picker"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False


class WallpaperPicker(Gtk.Window):
    def __init__(self):
        super().__init__(title="Wallpaper")
        self.set_default_size(760, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.buttons = []
        self.current_preview = None
        self.wallpapers = []
        self.connect("key-press-event", self.on_key_press)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        frame.get_style_context().add_class("shell-frame")
        self.add(frame)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        frame.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="Wallpaper Picker", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(label="Click a wallpaper to apply it immediately", xalign=0)
        subtitle.get_style_context().add_class("subtitle")
        title_box.pack_start(title, False, False, 0)
        title_box.pack_start(subtitle, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        next_button = Gtk.Button(label="Next Wallpaper")
        next_button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        next_button.get_style_context().add_class("next-button")
        next_button.connect("button-press-event", self.run_next)
        header.pack_end(next_button, False, False, 0)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search wallpapers")
        self.search.connect("search-changed", self.filter_rows)
        frame.pack_start(self.search, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        frame.pack_start(scroller, True, True, 0)

        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroller.add(self.list_box)

        self.wallpapers = sorted(iter_wallpapers(), key=lambda p: p.name.lower())
        if not self.wallpapers:
            empty = Gtk.Label(label="No wallpapers found in ~/.wallpapers or ~/Pictures/Wallpapers")
            empty.get_style_context().add_class("subtitle")
            self.list_box.pack_start(empty, False, False, 24)
        for index, path in enumerate(self.wallpapers, 1):
            self.add_wallpaper_button(index, path)

    def add_wallpaper_button(self, index, path):
        button = Gtk.Button()
        button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK)
        button.path = str(path)
        button.search_text = f"{path.name} {path}".lower()
        button.connect("button-press-event", self.set_wallpaper, str(path))
        button.connect("enter-notify-event", self.preview_wallpaper, str(path))

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 96, 54, True)
            row.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
        except Exception:
            pass

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(label=f"{index}. {path.name}", xalign=0)
        name.get_style_context().add_class("wallpaper-name")
        full_path = Gtk.Label(label=str(path), xalign=0)
        full_path.get_style_context().add_class("wallpaper-path")
        full_path.set_ellipsize(3)
        text.pack_start(name, False, False, 0)
        text.pack_start(full_path, False, False, 0)
        row.pack_start(text, True, True, 0)

        button.add(row)
        self.buttons.append(button)
        self.list_box.pack_start(button, False, False, 0)

    def set_wallpaper(self, _button, event, path):
        if getattr(event, "button", 1) != 1:
            return False
        log(f"set requested: {path}")
        if self.apply_wallpaper(path, "set"):
            Gtk.main_quit()
        return True

    def preview_wallpaper(self, _button, _event, path):
        if self.current_preview == path:
            return False
        self.current_preview = path
        self.apply_wallpaper(path, "preview")
        return False

    def apply_wallpaper(self, path, reason):
        try:
            result = subprocess.run([str(WALLPAPER_SET), path], capture_output=True, text=True, timeout=10)
            log(f"{reason} rc={result.returncode} path={path} stdout={result.stdout.strip()} stderr={result.stderr.strip()}")
        except Exception as exc:
            log(f"{reason} exception: {exc}")
            notify("Wallpaper Failed", str(exc))
            return False
        if result.returncode != 0:
            notify("Wallpaper Failed", path)
            return False
        return True

    def run_next(self, _button, event):
        if getattr(event, "button", 1) != 1:
            return False
        log("next requested")
        try:
            result = subprocess.run([str(WALLPAPER_NEXT)], capture_output=True, text=True, timeout=10)
            log(f"next rc={result.returncode} stdout={result.stdout.strip()} stderr={result.stderr.strip()}")
        except Exception as exc:
            log(f"next exception: {exc}")
            notify("Wallpaper Failed", str(exc))
            return True
        if result.returncode == 0:
            Gtk.main_quit()
        else:
            notify("Wallpaper Failed", "Could not switch to next wallpaper")
        return True

    def on_key_press(self, _window, event):
        key_name = Gdk.keyval_name(event.keyval)
        if key_name == "Escape":
            Gtk.main_quit()
            return True
        if key_name in {"n", "N"}:
            log("next requested by key")
            try:
                result = subprocess.run([str(WALLPAPER_NEXT)], capture_output=True, text=True, timeout=10)
                log(f"next-key rc={result.returncode} stdout={result.stdout.strip()} stderr={result.stderr.strip()}")
            except Exception as exc:
                log(f"next-key exception: {exc}")
                notify("Wallpaper Failed", str(exc))
                return True
            if result.returncode == 0:
                Gtk.main_quit()
            return True
        if key_name and key_name.isdigit():
            index = int(key_name) - 1
            if 0 <= index < len(self.wallpapers):
                path = str(self.wallpapers[index])
                log(f"set requested by key {key_name}: {path}")
                if self.apply_wallpaper(path, f"key-{key_name}"):
                    Gtk.main_quit()
                return True
        return False

    def filter_rows(self, entry):
        query = entry.get_text().strip().lower()
        for button in self.buttons:
            button.set_visible(query in button.search_text)


def main():
    if focus_existing_picker():
        return
    load_css()
    window = WallpaperPicker()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    window.present()
    Gtk.main()


if __name__ == "__main__":
    main()
