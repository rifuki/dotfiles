#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/rifuki-shell/current-wallpaper"
current=""
[ -f "$state_file" ] && current="$(sed -n '1p' "$state_file")"

if [ -n "$current" ] && [ -f "$current" ]; then
  base_dir="$(dirname "$current")"
else
  base_dir="$HOME/.wallpapers"
fi

[ -d "$base_dir" ] || base_dir="$HOME/Pictures/Wallpapers"
[ -d "$base_dir" ] || exit 0

mapfile -t wallpapers < <(find -L "$base_dir" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
  2>/dev/null | sort)

[ "${#wallpapers[@]}" -gt 0 ] || exit 0

next="${wallpapers[0]}"
for i in "${!wallpapers[@]}"; do
  if [ "${wallpapers[$i]}" = "$current" ]; then
    next="${wallpapers[$(((i + 1) % ${#wallpapers[@]}))]}"
    break
  fi
done

exec "$script_dir/wallpaper-set" "$next"
